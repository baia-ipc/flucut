#!/usr/bin/env python3
"""
Write an overview of several samples analysed with flucut-posthoc.

Usage:
    flucut-posthoc-overview [options] -o <outdir> <summary>...

Arguments:
    <summary>  posthoc_summary.json of a sample.

Options:
    -o --outdir <dir>  Directory for overview.tsv and overview.html.
    --reports          Also write the report of each sample again from
                       its summary (after an update of flucut-posthoc).
    --segment <gene>   Also write coverage_<gene>.html: the coverage of
                       that segment (e.g. HA) in each sample, measured
                       and as flucut predicts it.
    -h --help          Show this help message and exit.
    -V --version       Show the version and exit.
"""

import os
import sys

from docopt import docopt

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from flucut_posthoc import __version__  # noqa: E402
from flucut_posthoc.overview import write_overview  # noqa: E402
from flucut_posthoc.segment_coverage import (  # noqa: E402
    write_segment_coverage)


def flucut_posthoc_overview(summaries: list[str], outdir: str,
                            reports: bool, segment: str | None) -> None:
    for path in summaries:
        if not os.path.exists(path):
            sys.exit(f"flucut-posthoc-overview: not found: {path}")
    os.makedirs(outdir, exist_ok=True)
    write_overview(summaries, outdir, reports)
    if segment:
        write_segment_coverage(summaries, outdir, segment)


if __name__ == "__main__":
    args = docopt(__doc__, version=__version__)
    flucut_posthoc_overview(args["<summary>"], args["--outdir"],
                            args["--reports"], args["--segment"])
